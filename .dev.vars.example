# Copy to .dev.vars for local runs (wrangler dev + scripts/check-feed.mjs).
# .dev.vars is gitignored. In production these are secrets, not vars:
#   npx wrangler secret put TWELVEDATA_KEY   (etc.)

TWELVEDATA_KEY="your-twelvedata-api-key"
TELEGRAM_TOKEN="123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TELEGRAM_CHAT_ID="123456789"
TRIGGER_SECRET="pick-a-long-random-string"
